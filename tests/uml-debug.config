# SPDX-License-Identifier: GPL-2.0
# UML debug fragment (on top of uml.config): KASAN, lockdep, kmemleak,
# UBSAN, debug objects, failslab. Uniprocessor: on UML, SMP needs
# seccomp=on userspace and KASAN stack walking then faults on secondary
# CPU stacks, so SMP is left out of the debug kernel.
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=n
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
# stress-failslab keeps failures out of vhci-hcd (reject-start/end)
CONFIG_FRAME_POINTER=y
CONFIG_FAULT_INJECTION_STACKTRACE_FILTER=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_WQ_WATCHDOG=y
CONFIG_PANIC_ON_OOPS=n
