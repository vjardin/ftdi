# SPDX-License-Identifier: GPL-2.0
# UML SMP fragment (on top of uml.config): 4 CPUs plus the debug checks
# that work with SMP on UML. Run with UML_EXTRA="seccomp=on ncpus=4"
# (make SMP=1 does it): UML SMP needs the seccomp userspace mode. KASAN
# is left out: its stack walking faults on secondary CPU stacks.
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_WQ_WATCHDOG=y
